# ===========================================================================
# newspipe — environment configuration
# Copy to `.env` and fill in secrets. Never commit `.env`.
# ===========================================================================

# --- Database ----------------------------------------------------------------
# Postgres connection URL (Postgres 16 via docker compose, host port 5433).
DATABASE_URL=postgresql://newspipe:newspipe@localhost:5433/newspipe

# --- LLM (labeling) ------------------------------------------------------------
# Three selectable labeler backends (local/glm/deepseek), each with its own
# credentials below. LABELER_PROVIDER picks the primary; LABELER_FALLBACK_PROVIDER
# (or "none") is used automatically when the primary has no key configured or
# fails a quick reachability probe. Leave the primary's key empty to run tests
# that mock the model or to skip live labeling.
LABELER_PROVIDER=local
LABELER_FALLBACK_PROVIDER=glm

# Local self-hosted OpenAI-compatible endpoint (e.g. a llama.cpp server). Free
# and private, but typically slower/lower concurrency than a hosted API.
LOCAL_LLM_API_KEY=
LOCAL_LLM_BASE_URL=https://api.agate.tr/v1
LOCAL_MODEL_NAME=local

# GLM (Z.ai). "Thinking" (extended reasoning) mode is always disabled for
# labeling calls — it's ~10x slower with no quality benefit for a
# one-sentence-rationale task.
GLM_LLM_API_KEY=
GLM_LLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL_NAME=glm-4.7-flashx

# DeepSeek (any OpenAI-compatible endpoint works here too — Groq, Together,
# Fireworks, etc.). `deepseek-chat` (V3) is the cost-effective default;
# `deepseek-reasoner` (R1) is pricier and overkill for one-sentence labeling.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# --- Labeling shape ------------------------------------------------------------
# Comma-separated category set the labeling model is constrained to (enforced
# as an enum via structured output). Defaults to the Phase 1 set.
LABEL_CATEGORIES=model_release,research,industry,funding,policy_regulation,tooling_infra,other
# Importance scale bounds (inclusive); the model's `importance` field is
# constrained to this range.
IMPORTANCE_MIN=1
IMPORTANCE_MAX=10

# --- Execution ---------------------------------------------------------------
# Max concurrent LLM calls when labeling a batch of stories.
BATCH_CONCURRENCY=8
# Cap on unlabeled stories labeled per `label` run (backfill guard).
LABEL_LIMIT_PER_RUN=100
# How often the labeling step actually runs, independent of the fetch/run
# cadence. 0 = label on every pipeline run (default).
LABEL_INTERVAL_MINUTES=0
# Which unlabeled stories a run picks (when not targeting specific story_ids).
# newest_per_source: round-robin across sources, newest first — keeps fresh
# news labeled promptly and stops one chatty source from filling the whole
# budget. oldest_first: original pure-FIFO (oldest unlabeled story wins).
LABEL_ORDER=newest_per_source

# --- Scheduler cadence ---------------------------------------------------------
# APScheduler CronTrigger fields for the hourly (incremental) pipeline run
# job. Defaults reproduce the original schedule: hourly at minute 5. Every
# run fetches all due sources and inserts only genuinely new items (dedup on
# external_id/title-hash) — "what's new since last check".
SCHEDULER_CRON_MINUTE=5
SCHEDULER_CRON_HOUR=*
# Once-a-day job (APScheduler CronTrigger fields) that forces a full 24h
# catch-up window instead of the incremental one. Currently only changes
# behavior for the Hacker News fetcher (whose window is normally "since last
# poll") — insurance against index/feed lag or a missed hourly tick.
DAILY_BACKFILL_CRON_HOUR=6
DAILY_BACKFILL_CRON_MINUTE=30

# --- Data retention ------------------------------------------------------------
# Days to keep news before it's hard-deleted (arrivals/stories/labels). Unset
# (leave empty) = keep forever. When set, a daily job purges expired data.
RETENTION_DAYS=

# --- Web UI --------------------------------------------------------------------
# Binds to localhost by default; change WEB_HOST only if you've put your own
# TLS/reverse proxy in front of it. Login is refused until ADMIN_PASSWORD is set.
WEB_HOST=127.0.0.1
WEB_PORT=8010
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Signs the session cookie. Regenerated on every restart if left empty (so
# sessions won't survive a restart); set it explicitly if that's undesirable.
WEB_SESSION_SECRET=

# --- Telegram bot ----------------------------------------------------------------
# Token from @BotFather on Telegram. Unset = `telegram-bot` refuses to start.
# Reactive @mention/command replies ("/news", "/news 6h", "/news today", or
# @-mentioning the bot in a group) work in any group it's a member of. The
# scheduled daily push only goes to the opt-in chat id allow-list below.
TELEGRAM_BOT_TOKEN=
# Access control: comma-separated chat ids (negative for groups/supergroups,
# positive for a private DM) allowed to use the bot at all. Empty = open —
# the bot replies in any chat it's added to or DM'd from. Once set, every
# other chat is silently ignored (no reply, so a stranger gets no signal
# it's even listening). To find a chat's id: message the bot from it, then
# check the logs for a "chat_not_allowed" line.
TELEGRAM_ALLOWED_CHAT_IDS=
# Self-service alternative/addition to the above: any chat that sends
# "/join <code>" matching this gets persisted as authorized (see
# db/telegram_auth.py) — share the code with people you want to have access,
# no need to look up and add their chat id yourself. Empty = disabled (the
# /join command just replies that codes aren't in use). Setting this alone
# (with TELEGRAM_ALLOWED_CHAT_IDS still empty) also switches the bot from
# open to restricted — everyone, including you, needs to /join once.
TELEGRAM_ACCESS_CODE=
# Comma-separated chat ids (negative for groups/supergroups) that receive the
# scheduled daily digest. Leave empty to disable the scheduled push entirely
# (reactive replies still work).
TELEGRAM_DIGEST_CHAT_IDS=
TELEGRAM_DAILY_DIGEST_CRON_HOUR=8
TELEGRAM_DAILY_DIGEST_CRON_MINUTE=0
# Lookback window used when a request doesn't specify one (e.g. a bare
# "@bot news").
TELEGRAM_DEFAULT_WINDOW_HOURS=3
# Max stories per digest message.
TELEGRAM_DIGEST_LIMIT=10

# Topic search (/topic web page and bot command): title search across ALL
# stories in the window, labeled or not. Default lookback in days, and the
# max days a request may widen it to (e.g. "/topic gemini 7" or ?days=7).
TOPIC_SEARCH_DEFAULT_DAYS=3
TOPIC_SEARCH_MAX_DAYS=7
# Max stories returned per search.
TOPIC_SEARCH_LIMIT=30
