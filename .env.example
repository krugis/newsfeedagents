# newspipe configuration — copy to .env and fill in.
# All configuration is env-driven (pydantic-settings); never hardcode secrets.

# Postgres 16 (started by `docker-compose up -d` in this repo).
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://newspipe:newspipe@localhost:5432/newspipe

# Anthropic API key used for LLM labeling (leave empty to run with labeling skipped).
ANTHROPIC_API_KEY=

# Model name used for labeling via langchain-anthropic.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Max concurrency for batched LLM labeling calls.
BATCH_CONCURRENCY=5
