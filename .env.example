# ===========================================================================
# newspipe — environment configuration
# Copy to `.env` and fill in secrets. Never commit `.env`.
# ===========================================================================

# --- Database ----------------------------------------------------------------
# Postgres connection URL (Postgres 16 via docker compose, host port 5433).
DATABASE_URL=postgresql://newspipe:newspipe@localhost:5433/newspipe

# --- LLM (labeling) ------------------------------------------------------------
# Any OpenAI-compatible endpoint works here — DeepSeek (default), OpenAI,
# Groq, Together, Fireworks, etc. Leave the key empty to run tests that mock
# the model or to skip live labeling.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Model used for labeling stories. `deepseek-chat` (V3) is the cost-effective
# default; `deepseek-reasoner` (R1) is pricier and overkill for one-sentence
# labeling.
MODEL_NAME=deepseek-chat

# --- Labeling shape ------------------------------------------------------------
# Comma-separated category set the labeling model is constrained to (enforced
# as an enum via structured output). Defaults to the Phase 1 set.
LABEL_CATEGORIES=model_release,research,industry,funding,policy_regulation,tooling_infra,other
# Importance scale bounds (inclusive); the model's `importance` field is
# constrained to this range.
IMPORTANCE_MIN=1
IMPORTANCE_MAX=10

# --- Execution ---------------------------------------------------------------
# Max concurrent LLM calls when labeling a batch of stories.
BATCH_CONCURRENCY=8
# Cap on unlabeled stories labeled per `label` run (backfill guard).
LABEL_LIMIT_PER_RUN=100
# How often the labeling step actually runs, independent of the fetch/run
# cadence. 0 = label on every pipeline run (default).
LABEL_INTERVAL_MINUTES=0

# --- Scheduler cadence ---------------------------------------------------------
# APScheduler CronTrigger fields for the pipeline run job. Defaults reproduce
# the original schedule: hourly at minute 5.
SCHEDULER_CRON_MINUTE=5
SCHEDULER_CRON_HOUR=*

# --- Data retention ------------------------------------------------------------
# Days to keep news before it's hard-deleted (arrivals/stories/labels). Unset
# (leave empty) = keep forever. When set, a daily job purges expired data.
RETENTION_DAYS=

# --- Web UI --------------------------------------------------------------------
# Binds to localhost by default; change WEB_HOST only if you've put your own
# TLS/reverse proxy in front of it. Login is refused until ADMIN_PASSWORD is set.
WEB_HOST=127.0.0.1
WEB_PORT=8010
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Signs the session cookie. Regenerated on every restart if left empty (so
# sessions won't survive a restart); set it explicitly if that's undesirable.
WEB_SESSION_SECRET=
