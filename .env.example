# newspipe configuration — copy to .env and fill in.
# All configuration is env-driven (pydantic-settings); never hardcode secrets.

# Postgres 16 (started by `docker-compose up -d` in this repo).
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://newspipe:newspipe@localhost:5432/newspipe

# DeepSeek API key used for LLM labeling (leave empty to run with labeling skipped).
DEEPSEEK_API_KEY=

# Model name used for labeling via langchain-deepseek.
DEEPSEEK_MODEL=deepseek-chat

# Max concurrency for batched LLM labeling calls.
BATCH_CONCURRENCY=5

# Max stories labeled per pipeline run (backlog drains over successive runs).
LABEL_LIMIT_PER_RUN=100

# Cron expression for the scheduler (UTC). Default: every 12 hours at 00:05 and 12:05.
# Examples: hourly at minute 5 -> "5 * * * *"; twice daily -> "5 0,12 * * *"; daily at 03:00 -> "0 3 * * *"
SCHEDULE_CRON=5 0,12 * * *
