[Unit]
Description=newspipe hourly GenAI/ML news ingestion scheduler
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Runs as the user who installs/enables the unit (root on this box).
# Working dir must contain the project; .env holds DATABASE_URL + DEEPSEEK_API_KEY.
WorkingDirectory=/home/agate/genai-news-pipeline
EnvironmentFile=/home/agate/genai-news-pipeline/.env
ExecStart=/home/agate/genai-news-pipeline/.venv/bin/python -m newspipe schedule
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
