# newspipe — Telegram news bot (@mention/command replies + scheduled daily push)
#
# Requires TELEGRAM_BOT_TOKEN set in .env (get one from @BotFather on
# Telegram) — the process refuses to start without it.
#
# Install:
#   sudo cp deploy/telegram-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start telegram-bot        # start now
#   sudo systemctl enable telegram-bot       # start on boot
#
# The project is currently owned by root on this server. If you run under a
# non-root account, change User= to that account and `chown -R` the project.

[Unit]
Description=newspipe — Telegram news bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/agate/newsfeedagents/genai-news-pipeline-claudecode
EnvironmentFile=/home/agate/newsfeedagents/genai-news-pipeline-claudecode/.env
ExecStart=/home/agate/newsfeedagents/genai-news-pipeline-claudecode/.venv/bin/python -m newspipe telegram-bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
